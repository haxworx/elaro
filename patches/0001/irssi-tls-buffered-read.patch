@@ -0,0 +1,94 @@
+/* Exercise the real IRC receive loop against tls-receive.py's local peer. */
+#include <irssi/src/common.h>
+#include <irssi/src/core/args.h>
+#include <irssi/src/core/chat-protocols.h>
+#include <irssi/src/core/core.h>
+#include <irssi/src/core/servers.h>
+#include <irssi/src/core/servers-setup.h>
+#include <irssi/src/core/settings.h>
+#include <irssi/src/core/signals.h>
+#include <irssi/src/irc/core/irc.h>
+#include <irssi/src/irc/core/irc-servers.h>
+
+#define MODULE_NAME "test-tls-receive"
+
+void irc_core_init(void);
+void irc_core_deinit(void);
+
+static GMainLoop *loop;
+static unsigned int received;
+
+static void registered(IRC_SERVER_REC *server)
+{
+	irc_send_cmd(server, "JOIN #test");
+}
+
+static void message(IRC_SERVER_REC *server, const char *args, const char *nick,
+                    const char *address)
+{
+	char *target, *body, *params, *expected;
+
+	params = event_get_params(args, 2 | PARAM_FLAG_GETREST, &target, &body);
+	g_assert_cmpstr(target, ==, "#test");
+	g_assert_cmpstr(nick, ==, "sender");
+	expected = g_strdup_printf("message-%03u ", received);
+	g_assert_true(g_str_has_prefix(body, expected));
+	g_free(expected);
+	g_free(params);
+	if (++received == 100)
+		g_main_loop_quit(loop);
+}
+
+static gboolean timed_out(gpointer data)
+{
+	g_main_loop_quit(loop);
+	return G_SOURCE_CONTINUE;
+}
+
+int main(int argc, char **argv)
+{
+	SERVER_CONNECT_REC *conn;
+	SERVER_REC *server;
+	guint timeout;
+
+	g_assert_cmpint(argc, ==, 4);
+	core_preinit(argv[0]);
+	irssi_gui = IRSSI_GUI_NONE;
+	args_execute(0, NULL);
+	core_init();
+	irc_core_init();
+	settings_add_str("lookandfeel", "term_charset", "UTF-8");
+	signal_add("event connected", (SIGNAL_FUNC) registered);
+	signal_add("event privmsg", (SIGNAL_FUNC) message);
+	signal_emit("irssi init finished", 0);
+	loop = g_main_loop_new(NULL, FALSE);
+	conn = server_create_conn(chat_protocol_lookup("IRC"), "127.0.0.1",
+	                          atoi(argv[1]), NULL, "", argv[2]);
+	g_assert_nonnull(conn);
+	conn->use_tls = TRUE;
+	conn->tls_verify = TRUE;
+	g_free(conn->tls_cafile);
+	conn->tls_cafile = g_strdup(argv[3]);
+	conn->no_autojoin_channels = TRUE;
+	conn->no_autosendcmd = TRUE;
+	server = server_connect(conn);
+	g_assert_nonnull(server);
+	server_ref(server);
+	server->no_reconnect = TRUE;
+	timeout = g_timeout_add_seconds(8, timed_out, NULL);
+	g_main_loop_run(loop);
+	g_source_remove(timeout);
+	g_printerr("%s received %u/100 messages\n", argv[2], received);
+	if (!server->disconnected) {
+		server->connection_lost = TRUE;
+		server_disconnect(server);
+	}
+	server_unref(server);
+	server_connect_unref(conn);
+	signal_remove("event privmsg", (SIGNAL_FUNC) message);
+	signal_remove("event connected", (SIGNAL_FUNC) registered);
+	irc_core_deinit();
+	core_deinit();
+	g_main_loop_unref(loop);
+	return received == 100 ? 0 : 1;
+}
