+typedef struct {
+	GSource source;
+	GPollFD poll;
+	GIOChannel *channel;
+	GIOCondition condition;
+} SSLWatch;
+
+static GIOCondition ssl_watch_condition(SSLWatch *watch)
+{
+	GIOSSLChannel *chan = (GIOSSLChannel *)watch->channel;
+	GIOCondition ready = watch->poll.revents;
+
+	/* SSL_read can leave decrypted bytes after draining the socket. They
+	 * must wake the next bounded read batch even without another packet. */
+	if ((watch->condition & G_IO_IN) && SSL_pending(chan->ssl) > 0)
+		ready |= G_IO_IN;
+	return ready & watch->condition;
+}
+
+static gboolean ssl_watch_prepare(GSource *source, gint *timeout)
+{
+	SSLWatch *watch = (SSLWatch *)source;
+	GIOSSLChannel *chan = (GIOSSLChannel *)watch->channel;
+
+	*timeout = -1;
+	return (watch->condition & G_IO_IN) && SSL_pending(chan->ssl) > 0;
+}
+
+static gboolean ssl_watch_check(GSource *source)
+{
+	return ssl_watch_condition((SSLWatch *)source) != 0;
+}
+
+static gboolean ssl_watch_dispatch(GSource *source, GSourceFunc callback, gpointer data)
+{
+	SSLWatch *watch = (SSLWatch *)source;
+	GIOFunc function = (GIOFunc)callback;
+
+	g_return_val_if_fail(function != NULL, G_SOURCE_REMOVE);
+	return function(watch->channel, ssl_watch_condition(watch), data);
+}
+
+static void ssl_watch_finalize(GSource *source)
+{
+	g_io_channel_unref(((SSLWatch *)source)->channel);
+}
+
+static GSourceFuncs ssl_watch_funcs = {
+	ssl_watch_prepare,
+	ssl_watch_check,
+	ssl_watch_dispatch,
+	ssl_watch_finalize,
+	NULL, NULL
+};
+
