+/* Preserve module filename construction without deprecated g_module_build_path. */
+static char *module_path_build(const char *directory, const char *name)
+{
+	char *filename, *path;
+
+#ifdef G_OS_WIN32
+	filename = g_str_has_suffix(name, "." G_MODULE_SUFFIX)
+	               ? g_strdup(name) : g_strconcat(name, "." G_MODULE_SUFFIX, NULL);
+#else
+	filename = g_str_has_prefix(name, "lib")
+	               ? g_strdup(name) : g_strconcat("lib", name, "." G_MODULE_SUFFIX, NULL);
+#endif
+	path = g_build_filename(directory, filename, NULL);
+	g_free(filename);
+	return path;
+}
