/* Shared contracts. Each EDC supplies its own palette and icon artwork. */
#include "progress.edc"
group { name: "elaro/frame";
 parts {
  part { name: "edge"; type: RECT; mouse_events: 0;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; color: EDGE; } }
  part { name: "surface"; type: RECT; mouse_events: 0;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; rel1.offset: 1 1; rel2.offset: -2 -2; color: BG; } }
  part { name: "accent"; type: RECT; mouse_events: 0;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; rel1.offset: 1 1; rel2 { relative: 1 0; offset: -2 2; } color: ACCENT; } }
  /* A real hit surface below the header's controls initiates window moves. */
  part { name: "move"; type: RECT;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; color: 0 0 0 0;
    rel1.offset: 5 5; rel2 { relative: 1 0; offset: -5 39; } }
  }
  part { name: "elaro.content"; type: SWALLOW;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; rel1.offset: 5 5; rel2.offset: -5 -5; } }
#define GRIP(n, x1, y1, x2, y2, ox1, oy1, ox2, oy2) \
  part { name: n; type: RECT; scale: 1; description { offset_scale: 1; state: "default" 0.0; color: 0 0 0 0; rel1 { relative: x1 y1; offset: ox1 oy1; } rel2 { relative: x2 y2; offset: ox2 oy2; } } }
  GRIP("top", 0,0,1,0, 5,0,-5,4)
  GRIP("bottom", 0,1,1,1, 5,-5,-5,-1)
  GRIP("left", 0,0,0,1, 0,5,4,-5)
  GRIP("right", 1,0,1,1, -5,5,-1,-5)
  GRIP("tl", 0,0,0,0, 0,0,4,4)
  GRIP("tr", 1,0,1,0, -5,0,-1,4)
  GRIP("bl", 0,1,0,1, 0,-5,4,-1)
  GRIP("br", 1,1,1,1, -5,-5,-1,-1)
 }

}
group { name: "elaro/dialog/frame";
 inherit: "elaro/frame";
 parts {
  part { name: "move"; mouse_events: 0; }
  part { name: "elaro.content";
   description { state: "default" 0.0; rel1.offset: 3 3; rel2.offset: -4 -4; }
  }
 }
}
group { name: "elm/bg/base/default";
 parts {
  part { name: "base"; type: RECT; mouse_events: 0; scale: 1; description { offset_scale: 1; state: "default" 0.0; color: BG; } }
  part { name: "elm.swallow.rectangle"; type: SWALLOW; scale: 1; description { offset_scale: 1; state: "default" 0.0; } }
  part { name: "elm.swallow.background"; type: SWALLOW; scale: 1; description { offset_scale: 1; state: "default" 0.0; } }
  part { name: "elm.swallow.content"; type: SWALLOW; scale: 1; description { offset_scale: 1; state: "default" 0.0; } }
 }
}
/* Quiet title-bar controls shared by windows and popup close buttons. */
group { name: "elm/button/base/elaro/window-control";
 min: 30 30;
 parts {
  part { name: "surface"; type: RECT; mouse_events: 0;
   scale: 1;
   description { state: "default" 0.0; color: 0 0 0 0; }
   description { state: "over" 0.0; color: EDGE; }
   description { state: "pressed" 0.0; color: PANEL; }
  }
  part { name: "elm.swallow.content"; type: SWALLOW;
   scale: 1;
   description { state: "default" 0.0; offset_scale: 1;
    rel1.offset: 5 5; rel2.offset: -5 -5; }
  }
  part { name: "event"; type: RECT; ignore_flags: ON_HOLD;
   description { state: "default" 0.0; color: 0 0 0 0; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; visible: 0; }
  }
 }
 programs {
  program { signal: "mouse,in"; source: "event"; action: STATE_SET "over" 0.0; target: "surface"; }
  program { signal: "mouse,out"; source: "event"; action: STATE_SET "default" 0.0; target: "surface"; }
  program { signal: "mouse,down,1"; source: "event"; action: SIGNAL_EMIT "elm,action,press" "elm"; after: "press"; }
  program { name: "press"; action: STATE_SET "pressed" 0.0; target: "surface"; }
  program { signal: "mouse,up,1"; source: "event"; action: SIGNAL_EMIT "elm,action,unpress" "elm"; after: "release"; }
  program { name: "release"; action: STATE_SET "over" 0.0; target: "surface"; }
  program { signal: "mouse,clicked,1"; source: "event"; action: SIGNAL_EMIT "elm,action,click" "elm"; }
  program { signal: "elm,state,disabled"; source: "elm"; action: STATE_SET "disabled" 0.0; target: "event"; }
  program { signal: "elm,state,enabled"; source: "elm"; action: STATE_SET "default" 0.0; target: "event"; }
  program { signal: "elm,action,focus_highlight,show"; source: "elm"; action: STATE_SET "over" 0.0; target: "surface"; }
  program { signal: "elm,action,focus_highlight,hide"; source: "elm"; action: STATE_SET "default" 0.0; target: "surface"; }
 }
}
group { name: "elm/button/base/elaro/window-close";
 inherit: "elm/button/base/elaro/window-control";
 parts {
  part { name: "surface";
   description { state: "over" 0.0; color: 214 66 86 48; }
   description { state: "pressed" 0.0; color: 214 66 86 88; }
  }
 }
}

group { name: "elm/button/base/default";
 min: 27 27;
 parts {
  part { name: "surface"; type: IMAGE; mouse_events: 0;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; image.normal: "button.svg"; image.border: 9 9 9 9; }
   description { offset_scale: 1; state: "over" 0.0; inherit: "default" 0.0; image.normal: "button-hover.svg"; }
   description { offset_scale: 1; state: "pressed" 0.0; inherit: "default" 0.0; image.normal: "button-pressed.svg"; }
   description { offset_scale: 1; state: "disabled" 0.0; inherit: "default" 0.0; color: 128 128 128 128; }
  }
  part { name: "border"; type: RECT; mouse_events: 0;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; visible: 0; color: ACCENT; rel2 { relative: 0 1; offset: 2 -1; } }
   description { offset_scale: 1; state: "selected" 0.0; inherit: "default" 0.0; visible: 1; }
  }
  part { name: "elm.swallow.content"; type: SWALLOW;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; rel1.offset: 6 5; rel2.offset: -7 -5; }
  }
  part { name: "elm.text"; type: TEXT; scale: 1; mouse_events: 0;
   description { offset_scale: 1; state: "default" 0.0; rel1.offset: 9 6; rel2.offset: -10 -7; color: INK;
    text { font: "Sans"; size: 11; text_class: "label"; min: 1 1; ellipsis: -1; } }
   description { offset_scale: 1; state: "disabled" 0.0; inherit: "default" 0.0; color: EDGE; }
  }
  part { name: "event"; type: RECT; ignore_flags: ON_HOLD;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; color: 0 0 0 0; }
   description { offset_scale: 1; state: "disabled" 0.0; inherit: "default" 0.0; visible: 0; }
  }
 }
 programs {
  program { signal: "elaro,selected,on"; source: "elaro"; action: STATE_SET "selected" 0.0; target: "border"; }
  program { signal: "elaro,selected,off"; source: "elaro"; action: STATE_SET "default" 0.0; target: "border"; }
  program { signal: "mouse,in"; source: "event"; action: STATE_SET "over" 0.0; target: "surface"; }
  program { signal: "mouse,out"; source: "event"; action: STATE_SET "default" 0.0; target: "surface"; }
  program { signal: "mouse,down,1"; source: "event"; action: SIGNAL_EMIT "elm,action,press" "elm"; after: "press"; }
  program { name: "press"; action: STATE_SET "pressed" 0.0; target: "surface"; }
  program { signal: "mouse,up,1"; source: "event"; action: SIGNAL_EMIT "elm,action,unpress" "elm"; after: "release"; }
  program { name: "release"; action: STATE_SET "default" 0.0; target: "surface"; }
  program { signal: "mouse,clicked,1"; source: "event"; action: SIGNAL_EMIT "elm,action,click" "elm"; }
  program { signal: "elm,state,disabled"; source: "elm"; action: STATE_SET "disabled" 0.0; target: "surface"; target: "event"; target: "elm.text"; }
  program { signal: "elm,state,enabled"; source: "elm"; action: STATE_SET "default" 0.0; target: "surface"; target: "event"; target: "elm.text"; }
  program { signal: "elm,action,focus_highlight,show"; source: "elm"; action: STATE_SET "over" 0.0; target: "surface"; }
  program { signal: "elm,action,focus_highlight,hide"; source: "elm"; action: STATE_SET "default" 0.0; target: "surface"; }
 }
}
group { name: "elm/button/base/combobox_vertical/default";
 alias: "elm/button/base/combobox_vertical/entry";
 inherit: "elm/button/base/default";
 parts {
  part { name: "elm.swallow.content";
   description { state: "default" 0.0; offset_scale: 1; rel1.offset: 6 3; rel2.offset: -32 -4; }
  }
  part { name: "elm.text";
   description { state: "default" 0.0; visible: 0; }
  }
  part { name: "divider"; type: RECT; scale: 1; mouse_events: 0;
   description { state: "default" 0.0; offset_scale: 1; color: EDGE;
    rel1 { relative: 1 0; offset: -29 6; } rel2.offset: -29 -7;
   }
  }
  part { name: "arrow"; type: TEXT; scale: 1; mouse_events: 0;
   description { state: "default" 0.0; offset_scale: 1; color: INK;
    rel1 { relative: 1 0; offset: -28 0; }
    text { text: "▾"; font: "Sans"; size: 18; align: 0.5 0.5; }
   }
  }
 }
}

group { name: "elm/hover/base/combobox_vertical/default";
 alias: "elm/hover/base/combobox_vertical/entry";
 parts {
  part { name: "elm.swallow.offset"; type: SWALLOW;
   description { state: "default" 0.0; fixed: 1 1; align: 0 0; rel2.relative: 0 0; }
  }
  part { name: "elm.swallow.size"; type: SWALLOW;
   description { state: "default" 0.0; fixed: 1 1; align: 0 0;
    rel.to: "elm.swallow.offset"; rel1.relative: 1 1;
   }
  }
  part { name: "dismiss"; type: RECT;
   description { state: "default" 0.0; color: 0 0 0 0; }
  }
  part { name: "elm.swallow.slot.middle"; type: SWALLOW;
   description { state: "default" 0.0; rel.to: "elm.swallow.size"; }
  }
  part { name: "elm.swallow.slot.top"; type: SWALLOW;
   description { state: "default" 0.0; fixed: 0 1; align: 0 1;
    rel.to: "elm.swallow.slot.middle"; rel1.relative: 0 0; rel2.relative: 1 0;
   }
  }
  part { name: "elm.swallow.slot.bottom"; type: SWALLOW;
   description { state: "default" 0.0; fixed: 0 1; align: 0 0;
    rel.to: "elm.swallow.slot.middle"; rel1.relative: 0 1; rel2.relative: 1 1;
   }
  }
 }
 programs {
  program { signal: "mouse,clicked,1"; source: "dismiss";
   action: SIGNAL_EMIT "elm,action,dismiss" "elm";
  }
 }
}

/* Context menus shared by the conversation and nick genlists. */
group { name: "elm/hover/base/menu/default";
 alias: "elm/hover/base/submenu/default";
 inherit: "elm/hover/base/combobox_vertical/default";
 parts {
  part { name: "menu-edge"; type: RECT; mouse_events: 0;
   insert_before: "menu-surface";
   description { state: "default" 0.0; offset_scale: 1;
    rel.to: "elm.swallow.slot.bottom"; rel1.offset: -1 -1; rel2.offset: 1 1; color: EDGE;
   }
  }
  part { name: "menu-surface"; type: RECT; mouse_events: 0;
   insert_before: "elm.swallow.slot.bottom";
   description { state: "default" 0.0; rel.to: "elm.swallow.slot.bottom"; color: BG; }
  }
 }
 programs {
  program { signal: "mouse,up,*"; source: "dismiss";
   action: SIGNAL_EMIT "elm,action,dismiss" "elm";
  }
 }
}

group { name: "elm/menu/item/default";
 parts {
  part { name: "surface"; type: RECT; mouse_events: 0; scale: 1;
   description { state: "default" 0.0; min: 120 30; color: BG; }
   description { state: "active" 0.0; inherit: "default" 0.0; color: PANEL; }
  }
  part { name: "accent"; type: RECT; mouse_events: 0; scale: 1;
   description { state: "default" 0.0; offset_scale: 1; visible: 0;
    rel2 { relative: 0 1; offset: 2 -1; } color: ACCENT;
   }
   description { state: "active" 0.0; inherit: "default" 0.0; visible: 1; }
  }
  part { name: "elm.swallow.content"; type: SWALLOW; mouse_events: 0; scale: 1;
   description { state: "default" 0.0; offset_scale: 1; fixed: 1 1; align: 0 0.5;
    rel1.offset: 9 6; rel2 { relative: 0 1; offset: 9 -7; } min: 15 15;
   }
   description { state: "noicon" 0.0; inherit: "default" 0.0; min: 0 0; visible: 0; }
  }
  part { name: "elm.text"; type: TEXT; mouse_events: 0; scale: 1;
   description { state: "default" 0.0; offset_scale: 1; color: INK;
    rel1 { to_x: "elm.swallow.content"; relative: 1 0; offset: 6 6; } rel2.offset: -19 -7;
    text { font: "Sans"; size: 11; text_class: "label"; min: 1 1; ellipsis: -1; align: 0 0.5; }
   }
   description { state: "disabled" 0.0; inherit: "default" 0.0; color: EDGE; }
  }
  part { name: "event"; type: RECT; ignore_flags: ON_HOLD;
   description { state: "default" 0.0; color: 0 0 0 0; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; visible: 0; }
  }
 }
 programs {
  program { signal: "mouse,in"; source: "event"; action: SIGNAL_EMIT "elm,action,activate" "elm"; after: "selected"; }
  program { signal: "mouse,out"; source: "event"; action: SIGNAL_EMIT "elm,action,inactivate" "elm"; after: "unselected"; }
  program { signal: "mouse,up,1"; source: "event"; action: SIGNAL_EMIT "elm,action,click" "elm"; }
  program { name: "selected"; signal: "elm,state,selected"; source: "elm"; action: STATE_SET "active" 0.0; target: "surface"; target: "accent"; }
  program { name: "unselected"; signal: "elm,state,unselected"; source: "elm"; action: STATE_SET "default" 0.0; target: "surface"; target: "accent"; }
  program { signal: "elm,state,icon,hidden"; source: "elm"; action: STATE_SET "noicon" 0.0; target: "elm.swallow.content"; }
  program { signal: "elm,state,icon,visible"; source: "elm"; action: STATE_SET "default" 0.0; target: "elm.swallow.content"; }
  program { signal: "elm,state,disabled"; source: "elm"; action: STATE_SET "disabled" 0.0; target: "elm.text"; target: "event"; }
  program { signal: "elm,state,enabled"; source: "elm"; action: STATE_SET "default" 0.0; target: "elm.text"; target: "event"; }
 }
}

group { name: "elm/menu/item_with_submenu/default";
 inherit: "elm/menu/item/default";
 parts { part { name: "arrow"; type: TEXT; mouse_events: 0; scale: 1;
  description { state: "default" 0.0; offset_scale: 1; color: INK;
   rel1 { relative: 1 0; offset: -17 0; } rel2.offset: -6 -1;
   text { text: "›"; font: "Sans"; size: 15; }
  }
 } }
 programs { program { signal: "mouse,in"; source: "event"; action: SIGNAL_EMIT "elm,action,open" "elm"; } }
}

group { name: "elm/menu/separator/default";
 parts {
  part { name: "space"; type: SPACER; scale: 1;
   description { state: "default" 0.0; min: 0 7; }
  }
  part { name: "line"; type: RECT; mouse_events: 0; scale: 1;
   description { state: "default" 0.0; offset_scale: 1; min: 0 1; max: 99999 1;
    rel1.offset: 9 0; rel2.offset: -10 -1; color: EDGE;
   }
  }
 }
}

group { name: "elm/separator/horizontal/default";
 parts { part { name: "line"; type: RECT; scale: 1; mouse_events: 0;
  description { state: "default" 0.0; min: 1 1; max: 99999 1; color: EDGE; }
 } }
}

group { name: "elm/genlist/item/default/default";
   alias: "elm/genlist/item/default/combobox_vertical/default";
   alias: "elm/genlist/item_odd/default/combobox_vertical/default";
   alias: "elm/genlist/item_compress/default/combobox_vertical/default";
   alias: "elm/genlist/item_compress_odd/default/combobox_vertical/default";
   alias: "elm/genlist/item_odd/default/default";
   alias: "elm/genlist/item_compress/default/default";
   alias: "elm/genlist/item_compress_odd/default/default";
   data.item: "texts" "elm.text";
   data.item: "contents" "elm.swallow.icon elm.swallow.end";
   data.item: "treesize" "20";
   alias: "elm/genlist/item/default_style/default";
 alias: "elm/genlist/item_odd/default_style/default";
 alias: "elm/genlist/item_compress/default_style/default";
 alias: "elm/genlist/item_compress_odd/default_style/default";
 data.item: "states" "private_unread mention";
   styles { style { name: "list_text"; base: LIST_STYLE;
      tag: "b" "+ font_weight=Bold";
      tag: "hilight" "+ font_weight=Bold";
   } }
   parts {
      part { name: "base"; type: RECT; mouse_events: 0;
         scale: 1; description { offset_scale: 1; state: "default" 0.0; color: BG; }
         description { offset_scale: 1; state: "over" 0.0; inherit: "default" 0.0; color: PANEL; }
         description { offset_scale: 1; state: "selected" 0.0; inherit: "default" 0.0; color: PANEL; }
      }
      part { name: "line"; type: RECT; scale: 1; mouse_events: 0;
         description { offset_scale: 1; state: "default" 0.0; 
            rel1.relative: 0 1; rel1.offset: 9 -1; rel2.offset: -10 -1; color: EDGE;
         }
      }
      part { name: "chosen"; type: RECT; scale: 1; mouse_events: 0;
         description { offset_scale: 1; state: "default" 0.0;  visible: 0;
            rel1.offset: 0 6; rel2 { relative: 0 1; offset: 2 -7; } color: ACCENT;
         }
         description { offset_scale: 1; state: "active" 0.0; inherit: "default" 0.0; visible: 1; }
      }
      /* A quiet breathing accent, independent of hover and selection. */
      part { name: "private-unread-clip"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0; color: 255 255 255 0; }
         description { state: "low" 0.0; color: 255 255 255 64; }
         description { state: "high" 0.0; color: 255 255 255 220; }
      }
      part { name: "private-unread"; type: RECT; scale: 1; mouse_events: 0;
         clip_to: "private-unread-clip";
         description { state: "default" 0.0; offset_scale: 1;
            rel1.offset: 0 9; rel2 { relative: 0 1; offset: 2 -10; }
            color: ACCENT;
         }
      }
      /* The genlist listens on its Edje view. A transparent hit surface
       * supplies events across the whole row; swallowed controls stay above it. */
      part { name: "event"; type: RECT;
         scale: 1; description { offset_scale: 1; state: "default" 0.0; color: 0 0 0 0; min: 0 32; }
      }
      part { name: "elm.swallow.pad"; type: SWALLOW; scale: 1; mouse_events: 0;
         description { state: "default" 0.0; fixed: 1 0; align: 0 0.5; rel2.relative: 0 1; }
      }
      part { name: "elm.swallow.icon"; type: SWALLOW; scale: 1;
         description { offset_scale: 1; state: "default" 0.0;  min: 24 29; fixed: 1 0;
            align: 0 0.5;
            rel1 { to_x: "elm.swallow.pad"; relative: 1 0; offset: 6 2; }
            rel2 { to_x: "elm.swallow.pad"; relative: 1 1; offset: 29 -3; }
         }
      }
      /* Mentions breathe beneath the name; private messages pulse at the edge. */
      part { name: "mention-clip"; type: RECT; mouse_events: 0;
         description { state: "default" 0.0; color: 255 255 255 0; }
         description { state: "low" 0.0; color: 255 255 255 64; }
         description { state: "high" 0.0; color: 255 255 255 230; }
      }
      part { name: "mention"; type: RECT; scale: 1; mouse_events: 0;
         clip_to: "mention-clip";
         description { state: "default" 0.0; offset_scale: 1;
            rel1 { to_x: "elm.swallow.icon"; relative: 1 1; offset: 6 -5; }
            rel2 { relative: 1 1; offset: -34 -4; }
            color_class: "/fg/normal/entry/mention";
         }
      }
      part { name: "elm.text"; type: TEXTBLOCK; scale: 1; mouse_events: 0;
         description { offset_scale: 1; state: "default" 0.0; 
            rel1 { to_x: "elm.swallow.icon"; relative: 1 0; offset: 6 7; }
            rel2.offset: -34 -8; color: 255 255 255 255;
            text { style: "list_text"; min: 0 1; align: 0 0.5; }
         }

      }
 part { name: "elm.swallow.end"; type: SWALLOW;
 scale: 1; description { offset_scale: 1; state: "default" 0.0; min: 18 18; max: 21 21; align: 1 0.5;
 rel1 { relative: 1 0; offset: -26 2; } rel2.offset: -5 -3; } }
   }
   programs {
 program { signal: "elm,state,selected"; source: "elm"; action: STATE_SET "active" 0.0; target: "chosen"; after: "select_surface"; }
 program { name: "select_surface"; action: STATE_SET "selected" 0.0; target: "base"; }
 program { signal: "elm,state,unselected"; source: "elm"; action: STATE_SET "default" 0.0; target: "chosen"; target: "base"; }
      program { signal: "mouse,in"; source: "*"; action: STATE_SET "over" 0.0; target: "base"; }
      program { signal: "mouse,out"; source: "*"; action: STATE_SET "default" 0.0; target: "base"; }
      program { signal: "elm,state,mention,active"; source: "elm";
         action: ACTION_STOP; target: "mention-in"; target: "mention-out";
         after: "mention-start";
      }
      program { name: "mention-start";
         action: STATE_SET "low" 0.0; target: "mention-clip"; after: "mention-in";
      }
      program { name: "mention-in";
         action: STATE_SET "high" 0.0; target: "mention-clip";
         transition: SINUSOIDAL 0.8; after: "mention-out";
      }
      program { name: "mention-out";
         action: STATE_SET "low" 0.0; target: "mention-clip";
         transition: SINUSOIDAL 0.8; after: "mention-in";
      }
      program { signal: "elm,state,mention,passive"; source: "elm";
         action: ACTION_STOP; target: "mention-in"; target: "mention-out";
         after: "mention-clear";
      }
      program { name: "mention-clear";
         action: STATE_SET "default" 0.0; target: "mention-clip";
      }
      program { signal: "elm,state,private_unread,active"; source: "elm";
         action: ACTION_STOP; target: "private-unread-in"; target: "private-unread-out";
         after: "private-unread-start";
      }
      program { name: "private-unread-start";
         action: STATE_SET "low" 0.0; target: "private-unread-clip"; after: "private-unread-in";
      }
      program { name: "private-unread-in";
         action: STATE_SET "high" 0.0; target: "private-unread-clip";
         transition: SINUSOIDAL 1.2; after: "private-unread-out";
      }
      program { name: "private-unread-out";
         action: STATE_SET "low" 0.0; target: "private-unread-clip";
         transition: SINUSOIDAL 1.2; after: "private-unread-in";
      }
      program { signal: "elm,state,private_unread,passive"; source: "elm";
         action: ACTION_STOP; target: "private-unread-in"; target: "private-unread-out";
         after: "private-unread-clear";
      }
      program { name: "private-unread-clear";
         action: STATE_SET "default" 0.0; target: "private-unread-clip";
      }

   }
}

/* Match the conversations' 20-pixel tree indent so icons and text align.
 * The expander occupies the space before the server icon. */
group { name: "elm/genlist/tree/default/default";
 alias: "elm/genlist/tree_odd/default/default";
 alias: "elm/genlist/tree_compress/default/default";
 alias: "elm/genlist/tree_compress_odd/default/default";
 alias: "elm/genlist/tree/default_style/default";
 alias: "elm/genlist/tree_odd/default_style/default";
 alias: "elm/genlist/tree_compress/default_style/default";
 alias: "elm/genlist/tree_compress_odd/default_style/default";
 inherit: "elm/genlist/item/default/default";
 parts {
  part { name: "elm.swallow.icon";
   description { state: "default" 0.0; rel1.offset: 26 2; rel2.offset: 49 -3; }
  }
  part { name: "arrow"; type: RECT; scale: 1;
   description { state: "default" 0.0; offset_scale: 1; color: 0 0 0 0;
    rel1 { to_x: "elm.swallow.pad"; relative: 1 0; offset: 3 0; }
    rel2 { to_x: "elm.swallow.pad"; relative: 1 1; offset: 20 -1; }
   }
  }
  part { name: "chevron"; type: TEXT; scale: 1; mouse_events: 0;
   description { state: "default" 0.0; rel.to: "arrow"; color: INK;
    text { text: "▸"; font: "Sans"; size: 14; }
   }
   description { state: "expanded" 0.0; inherit: "default" 0.0; text.text: "▾"; }
  }
 }
 programs {
  program { signal: "mouse,up,1"; source: "arrow"; action: SIGNAL_EMIT "elm,action,expand,toggle" "elm"; }
  program { signal: "elm,state,expanded"; source: "elm"; action: STATE_SET "expanded" 0.0; target: "chevron"; }
  program { signal: "elm,state,contracted"; source: "elm"; action: STATE_SET "default" 0.0; target: "chevron"; }
 }
}

/* Selection belongs to the widget, not pointer hover or press state. */
group { name: "elm/check/base/default";
 parts {
  part { name: "clip"; type: RECT; mouse_events: 0;
   description { state: "default" 0.0; color: 255 255 255 255; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; color: 255 255 255 110; }
  }
  part { name: "outline"; type: RECT; scale: 1; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; offset_scale: 1;
    min: 17 17; max: 17 17; align: 0 0.5;
    rel1.offset: 5 0; rel2.relative: 0 1; rel2.offset: 5 -1; color: INK;
   }
  }
  part { name: "box"; type: RECT; scale: 1; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; offset_scale: 1;
    rel.to: "outline"; rel1.offset: 2 2; rel2.offset: -2 -2; color: PANEL;
   }
   description { state: "checked" 0.0; inherit: "default" 0.0; color: ACCENT; }
  }
  part { name: "mark"; type: TEXT; scale: 1; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; rel.to: "box"; visible: 0; color: BG;
    text { text: "✓"; font: "Sans:style=Bold"; size: 15; align: 0.5 0.5; }
   }
   description { state: "checked" 0.0; inherit: "default" 0.0; visible: 1; }
  }
  part { name: "elm.swallow.content"; type: SWALLOW; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; visible: 0; }
  }
  part { name: "elm.text"; type: TEXT; scale: 1; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; offset_scale: 1;
    rel1.offset: 30 6; rel2.offset: -5 -7; color: INK;
    text { font: "Sans"; size: 11; text_class: "label"; min: 1 1; align: 0 0.5; }
   }
  }
  part { name: "event"; type: RECT; ignore_flags: ON_HOLD;
   description { state: "default" 0.0; color: 0 0 0 0; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; visible: 0; }
  }
 }
 programs {
  program { signal: "mouse,clicked,1"; source: "event";
   action: SIGNAL_EMIT "elm,action,check,toggle" "elm";
  }
  program { signal: "elm,state,check,on"; source: "elm";
   action: STATE_SET "checked" 0.0; target: "box"; target: "mark";
  }
  program { signal: "elm,state,check,off"; source: "elm";
   action: STATE_SET "default" 0.0; target: "box"; target: "mark";
  }
  program { signal: "elm,state,disabled"; source: "elm";
   action: STATE_SET "disabled" 0.0; target: "clip"; target: "event";
  }
  program { signal: "elm,state,enabled"; source: "elm";
   action: STATE_SET "default" 0.0; target: "clip"; target: "event";
  }
 }
}

/* Single-line fields have no vertical scroll chrome or extra content inset. */
group { name: "elm/scroller/entry_single/default";
 alias: "elm/scroller/entry_single/combobox_vertical/default";
 parts {
  part { name: "bg"; type: RECT; mouse_events: 0;
   description { state: "default" 0.0; color: PANEL; }
  }
  part { name: "clip"; type: RECT; mouse_events: 0;
   description { state: "default" 0.0; }
  }
  part { name: "elm.swallow.background"; type: SWALLOW; mouse_events: 0; clip_to: "clip";
   description { state: "default" 0.0; }
  }
  part { name: "elm.swallow.content"; type: SWALLOW; clip_to: "clip";
   description { state: "default" 0.0; }
  }
 }
}

group { name: "elm/entry/anchor/default";
 parts { part { name: "underline"; type: RECT; scale: 1; mouse_events: 0;
  description { state: "default" 0.0; offset_scale: 1; fixed: 0 1;
   rel1.relative: 0 1; rel1.offset: 0 -2; color: ACCENT;
  }
 } }
}

/* History owns its surface, text layout and scrollbar independently of forms. */
group { name: "elm/scroller/entry/elaro/history";
 alias: "elm/genlist/base/default";
 alias: "elm/genlist/base/combobox_vertical/default";
 inherit: "elm/scroller/entry_single/default";
 parts {
  part { name: "bg";
   description { state: "default" 0.0; color: BG; }
  }
  part { name: "clip";
   description { state: "default" 0.0; offset_scale: 1; rel2.offset: -10 -1; }
  }
  part { name: "track"; type: RECT; scale: 1; mouse_events: 0;
   description { state: "default" 0.0; offset_scale: 1;
    rel1 { relative: 1 0; offset: -7 3; } rel2.offset: -4 -4; color: PANEL;
   }
  }
  part { name: "elm.dragable.vbar"; type: RECT; scale: 1;
   dragable { x: 0 0 0; y: 1 1 0; confine: "track"; }
   description { state: "default" 0.0; rel.to: "track"; min: 3 15; fixed: 1 1; color: ACCENT; }
   description { state: "hidden" 0.0; inherit: "default" 0.0; visible: 0; }
  }
 }
 programs {
  program { signal: "elm,action,show,vbar"; source: "elm";
   action: STATE_SET "default" 0.0; target: "elm.dragable.vbar";
  }
  program { signal: "elm,action,hide,vbar"; source: "elm";
   action: STATE_SET "hidden" 0.0; target: "elm.dragable.vbar";
  }
 }
}

group { name: "elm/entry/base-noedit-mixedwrap/elaro/history";
 alias: "elm/entry/base-noedit/elaro/history";
 styles {
  style { name: "history"; base: ENTRY_STYLE;
   tag: "b" "+ font_weight=Bold";
   tag: "i" "+ font_style=Italic";
   tag: "em" "+ font_style=Italic";
   tag: "hilight" "+ font_weight=Bold";
   tag: "link" "+ underline=on underline_color=cc:/fg/normal/entry/anchor";
   tag: "mention" "+ color=cc:/fg/normal/entry/mention";
  }
 }
 parts {
  part { name: "elm.text"; type: TEXTBLOCK; scale: 1; entry_mode: PLAIN;
   select_mode: DEFAULT; multiline: 1;
   source: "elm/entry/selection/default"; source6: "elm/entry/anchor/default";
   description { state: "default" 0.0; offset_scale: 1; fixed: 1 0;
    rel1.offset: 8 6; rel2.offset: -8 -7;
    text { style: "history"; min: 0 1; align: 0 0; }
   }
  }
 }
 programs {
  program { signal: "load"; source: ""; action: FOCUS_SET; target: "elm.text"; }
 }
}

/* Both the application name and conversation heading use this contract. */
group { name: "elm/label/base/elaro/title";
 styles {
  style { name: "title";
   base: "font=Sans:style=Bold font_size=13 text_class=label color=#ffffffff align=center wrap=none ellipsis=1.0";
   tag: "b" "+ font_weight=Bold";
  }
 }
 parts {
  part { name: "elm.text"; type: TEXTBLOCK; scale: 1; mouse_events: 0;
   description { state: "default" 0.0; offset_scale: 1;
    rel1.offset: 6 5; rel2.offset: -7 -5; color: INK;
    text { style: "title"; min: 1 1; align: 0.5 0.5; }
   }
   description { state: "horizontal_fixed" 0.0; inherit: "default" 0.0;
    fixed: 1 0; text.min: 0 1;
   }
  }
 }
 programs {
  program { signal: "elm,state,horizontal,fixed"; source: "elm";
   action: STATE_SET "horizontal_fixed" 0.0; target: "elm.text";
  }
  program { signal: "elm,state,horizontal,expandable"; source: "elm";
   action: STATE_SET "default" 0.0; target: "elm.text";
  }
 }
}

group { name: "elm/entry/base-single/default";
 alias: "elm/entry/base-single/combobox_vertical/default";
   styles {
      style { name: "ui_entry"; base: ENTRY_STYLE; }
      style { name: "ui_placeholder"; base: GUIDE_STYLE; }
   }
   parts {
      part { name: "surface"; type: RECT; mouse_events: 0;
         scale: 1; description { offset_scale: 1; state: "default" 0.0; color: PANEL; }
      }
      part { name: "elm.guide"; type: TEXTBLOCK; scale: 1; mouse_events: 0;
         description { offset_scale: 1; state: "default" 0.0; rel.to: "elm.text";
            text { style: "ui_placeholder"; min: 0 1; align: 0 0.5; }
         }
         description { offset_scale: 1; state: "hidden" 0.0; inherit: "default" 0.0; visible: 0; }
      }
      part { name: "elm.text"; type: TEXTBLOCK; scale: 1; entry_mode: EDITABLE; select_mode: DEFAULT;
         cursor_mode: BEFORE; multiline: 0;
         source: "elm/entry/selection/default"; source4: "elm/entry/cursor/default";
         description { offset_scale: 1; state: "default" 0.0; 
            rel1.offset: 11 2; rel2.offset: -11 -2;
            text { style: "ui_entry"; min: 1 1; align: 0 0.5; }
         }
      }
   }
   programs {
      /* Elementary focuses the Edje object; Edje must route keys to the entry. */
      program { signal: "load"; source: "";
         action: FOCUS_SET; target: "elm.text";
      }
      program { signal: "elm,guide,disabled"; source: "elm"; action: STATE_SET "hidden" 0.0; target: "elm.guide"; }
      program { signal: "elm,guide,enabled"; source: "elm"; action: STATE_SET "default" 0.0; target: "elm.guide"; }
   }
}

group { name: "elm/entry/base-single-noedit/combobox_vertical/default";
 inherit: "elm/entry/base-single/default";
 parts { part { name: "elm.text"; entry_mode: PLAIN; source4: ""; } }
}

/* Password fields use their own Elementary contract, never an editable alias. */
group { name: "elm/entry/base-password/default";
 inherit: "elm/entry/base-single/default";
 parts {
  part { name: "elm.text"; entry_mode: PASSWORD; multiline: 0;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; text.repch: "•"; }
  }
 }
}

group { name: "elm/entry/selection/default";
   parts { part { name: "selection"; type: RECT; mouse_events: 0;
      scale: 1; description { offset_scale: 1; state: "default" 0.0; color: ACCENT; color2: 255 255 255 255; }
   } }
}
group { name: "elm/label/base/default";
   styles { style { name: "ui_label"; base: ENTRY_STYLE " text_class=label"; } }
   parts { part { name: "elm.text"; type: TEXTBLOCK; scale: 1; mouse_events: 0;
      description { offset_scale: 1; state: "default" 0.0;
         text { style: "ui_label"; min: 1 1; }
      }
   } }
}

group { name: "elm/entry/cursor/default";
   min: 1 0;
   parts {
      part { name: "cursor"; type: RECT; mouse_events: 0;
         scale: 1;
         clip_to: "clipper";
         description { offset_scale: 1; state: "default" 0.0;
            min: 1 8;
            color_class: "/fg/normal/entry/cursor";
            visible: 0;
         }
         description { offset_scale: 1; state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "clipper"; type: RECT;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            rel.to: "cursor";
            fixed: 1 1;
         }
         description { offset_scale: 1; state: "hidden" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   programs {
      program { signal: "selection,changed"; source: "elm.text";
         action: STATE_SET "hidden" 0.0;
         target: "clipper";
      }
      program { signal: "selection,cleared"; source: "elm.text";
         action: STATE_SET "default" 0.0;
         target: "clipper";
      }
      program { signal: "selection,reset"; source: "elm.text";
         action: STATE_SET "default" 0.0;
         target: "clipper";
      }
      program { signal: "elm,action,focus"; source: "elm";
         action: ACTION_STOP;
         target: "cursor_show";
         target: "cursor_hide";
         target: "cursor_show_timer";
         target: "cursor_hide_timer";
         after: "cursor_show";
      }
      program { signal: "elm,action,unfocus"; source: "elm";
         action: ACTION_STOP;
         target: "cursor_show";
         target: "cursor_hide";
         target: "cursor_show_timer";
         target: "cursor_hide_timer";
         after: "cursor_hide_stop";
      }
      program { signal: "elm,action,show,cursor"; source: "elm";
         action: ACTION_STOP;
         target: "cursor_show";
         target: "cursor_hide";
         target: "cursor_show_timer";
         target: "cursor_hide_timer";
         after: "cursor_show";
      }
      program { name: "cursor_hide_stop";
         action: STATE_SET "default" 0.0;
         target: "cursor";
      }
      program { name: "cursor_show";
         action: STATE_SET "visible" 0.0;
         target: "cursor";
         after: "cursor_show_timer";
      }
      program { name: "cursor_hide";
         action: STATE_SET "default" 0.0;
         target: "cursor";
         after: "cursor_hide_timer";
      }
      program { name: "cursor_show_timer";
         in: 0.5 0.0;
         after: "cursor_hide";
      }
      program { name: "cursor_hide_timer";
         in: 0.3 0.0;
         after: "cursor_show";
      }
   }
}


/* Each theme supplies its own illustration for the About masthead. */
group { name: "elaro/about/hero";
 min: 240 131;
 parts {
  part { name: "artwork"; type: IMAGE; mouse_events: 0;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; image.normal: "about.svg"; image.border: 11 11 11 11; } }
  part { name: "name"; type: TEXT; scale: 1; mouse_events: 0;
   description { offset_scale: 1; state: "default" 0.0; rel1.offset: 21 57; rel2 { relative: 1 0; offset: -22 85; }
    color: INK; text { text: "E L A R O"; font: "Sans:style=Bold"; size: 27; align: 0 0.5; min: 0 1; } }
  }
  part { name: "tagline"; type: TEXT; scale: 1; mouse_events: 0;
   description { offset_scale: 1; state: "default" 0.0; rel1.offset: 22 90; rel2 { relative: 1 0; offset: -22 108; }
    color: INK; text { text: "An enlightened IRC client"; font: "Sans"; size: 11; text_class: "label"; align: 0 0.5; min: 0 1; } }
  }
 }
}

/* Popup lifecycle is animated in Edje. The toolkit owns the input blocker
 * until both fades finish and emits dismissed before the C owner deletes it. */
group { name: "elm/notify/center/popup/default";
 alias: "elm/notify/top/popup/default";
 alias: "elm/notify/bottom/popup/default";
 alias: "elm/notify/left/popup/default";
 alias: "elm/notify/right/popup/default";
 alias: "elm/notify/top_left/popup/default";
 alias: "elm/notify/top_right/popup/default";
 alias: "elm/notify/bottom_left/popup/default";
 alias: "elm/notify/bottom_right/popup/default";
 data.item: "hide_finished_signal" "on";
 parts {
  part { name: "clip"; type: RECT; mouse_events: 0;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; rel1.offset: -75 -75; rel2.offset: 74 74; color: 255 255 255 0; }
   description { offset_scale: 1; state: "visible" 0.0; inherit: "default" 0.0; color: 255 255 255 255; }
  }
  part { name: "shadow"; type: RECT; mouse_events: 0; clip_to: "clip";
   scale: 1; description { offset_scale: 1; state: "default" 0.0; rel.to: "base"; rel1.offset: -3 -2; rel2.offset: 2 5; color: 0 0 0 42; }
  }
  part { name: "edge"; type: RECT; mouse_events: 0; clip_to: "clip";
   scale: 1; description { offset_scale: 1; state: "default" 0.0; rel.to: "base"; rel1.offset: -1 -1; rel2.offset: 0 0; color: EDGE; }
  }
  part { name: "base"; type: RECT; clip_to: "clip";
   scale: 1; description { offset_scale: 1; state: "default" 0.0; color: BG;
    rel1.offset: 8 15; rel2.offset: -8 -1; }
   description { offset_scale: 1; state: "visible" 0.0; inherit: "default" 0.0;
    rel1.offset: 8 8; rel2.offset: -8 -8; }
  }
  part { name: "elm.swallow.content"; type: SWALLOW; clip_to: "clip";
   scale: 1; description { offset_scale: 1; state: "default" 0.0; rel.to: "base"; rel1.offset: 9 9; rel2.offset: -10 -10; }
  }
 }
 programs {
  program { signal: "show"; source: ""; action: STATE_SET "visible" 0.0;
   target: "clip"; target: "base"; transition: DECELERATE 0.16; }
  program { signal: "hide"; source: ""; action: STATE_SET "default" 0.0; target: "clip"; target: "base"; }
  program { signal: "elm,state,hide"; source: "elm";
   action: STATE_SET "default" 0.0; target: "clip"; target: "base";
   transition: ACCELERATE 0.12; after: "hide_finish"; }
  program { name: "hide_finish"; action: SIGNAL_EMIT "elm,action,hide,finished" "elm"; }
 }
}
group { name: "elm/notify/block_events/popup/default";
 data.item: "hide_finished_signal" "on";
 parts {
  part { name: "block_events"; type: RECT;
   scale: 1; description { offset_scale: 1; state: "default" 0.0; color: 0 0 0 0; }
   description { offset_scale: 1; state: "visible" 0.0; color: 0 0 0 144; }
  }
 }
 programs {
  program { signal: "mouse,clicked,1"; source: "block_events"; action: SIGNAL_EMIT "elm,action,click" "elm"; }
  program { signal: "show"; source: "*"; action: STATE_SET "visible" 0.0; target: "block_events"; transition: DECELERATE 0.16; }
  program { signal: "hide"; source: ""; action: STATE_SET "default" 0.0; target: "block_events"; }
  program { signal: "elm,state,hide"; source: "elm";
   action: STATE_SET "default" 0.0; target: "block_events";
   transition: ACCELERATE 0.12; after: "hide_finish"; }
  program { name: "hide_finish"; action: SIGNAL_EMIT "elm,action,hide,finished" "elm"; }
 }
}

/* The same tab strip is used by Settings and About. */
group { name: "elm/segment_control/base/default";
 parts { part { name: "background"; type: RECT; mouse_events: 0;
  scale: 1; description { offset_scale: 1; state: "default" 0.0; min: 120 27; color: PANEL; }
 } }
}

/* Themed panel grips retain Elementary drag and size constraints. */
group { name: "elm/panes/vertical/default";

   parts {
      part { name: "whole"; type: SPACER;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
         }
      }
      part { name: "right_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 1 1 1;
            y: 0 0 0;
         }
         description { offset_scale: 1; state: "default" 0.0;
            max: 0 0;
         }
      }
      part { name: "left_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 1 1 1;
            y: 0 0 0;
         }
         description { offset_scale: 1; state: "default" 0.0;
            max: 0 0;
         }
      }
      part { name: "sub_whole"; type: SPACER;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            rel1.relative: 1.0 0.0;
            rel1.to_x: "left_constraint";
            rel2.relative: 0.0 1.0;
            rel2.to_x: "right_constraint";
         }
      }
      part { name: "whole_left"; type: RECT;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            rel2.to_x: "elm.bar";
            rel2.relative: 0.0 1.0;
         }
      }
      part { name: "whole_right"; type: RECT;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            rel1.to_x: "elm.bar";
            rel1.relative: 1.0 0.0;
         }
      }
      part { name: "elm.swallow.left"; type: SWALLOW;
         clip_to: "whole_left";
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            rel2.to_x: "elm.bar";
            rel2.relative: 0.0 1.0;
         }
      }
      part { name: "elm.swallow.right"; type: SWALLOW;
         clip_to: "whole_right";
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            rel1.to_x: "elm.bar";
            rel1.relative: 1.0 0.0;
         }
      }
      part { name: "elm.bar"; type: SPACER;
         scale: 1;
         dragable { confine: "sub_whole";
            x: 1 1 1;
            y: 0 0 0;
         }
         description { offset_scale: 1; state: "default" 0.0;
            max: 9 99999;
            min: 9 24;
            fixed: 1 1;
            rel1.relative: 0.0 0.5;
            rel2.relative: 1.0 0.5;
         }
      }
      part { name: "dots"; mouse_events: 0;
         scale: 1;
         description { offset_scale: 1; state: "default" 0.0;
            min: 9 30; max: 9 30;
            image.normal: "handle.svg";
            rel.to: "elm.bar";
            color: 210 210 210 210;
         }
         description { offset_scale: 1; state: "over" 0.0; inherit: "default" 0.0; color: 255 255 255 255; }
         description { offset_scale: 1; state: "pressed" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255;
         }
      }
      part { name: "elm.swallow.event"; type: SWALLOW;
         scale: 1;
         description { offset_scale: 1; state: "default" 0.0;
            visible: 0;
            min: 9 24;
            fixed: 1 1;
            rel.to: "elm.bar";
         }
      }
      part { name: "bar"; type: RECT;
         scale: 1;
         dragable.events: "elm.bar";
         description { offset_scale: 1; state: "default" 0.0;
            min: 9 24;
            max: 99999 99999;
            fixed: 1 1;
            rel1.to_x: "elm.swallow.event";
            rel2.to_x: "elm.swallow.event";
            color: 0 0 0 0; // no cc
         }
         description { offset_scale: 1; state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   programs {
      program { signal: "mouse,in"; source: "bar"; action: STATE_SET "over" 0.0; target: "dots"; }
      program { signal: "mouse,out"; source: "bar"; action: STATE_SET "default" 0.0; target: "dots"; }
      program { signal: "mouse,down,1"; source: "bar"; // for "press" smart callback
         action: SIGNAL_EMIT "elm,action,press" "elm";
      }
      program { signal: "mouse,up,1"; source: "bar"; // for "unpress" smart callback
         action: SIGNAL_EMIT "elm,action,unpress" "elm";
      }
      program { name: "bar_down";
         signal: "mouse,down,1"; source: "bar";
         action: STATE_SET "pressed" 0.0;
         target: "dots";
      }
      program { name: "bar_up";
         signal: "mouse,up,1"; source: "bar";
         action: STATE_SET "default" 0.0;
         target: "dots";
      }
      program { signal: "mouse,clicked,1"; source: "bar"; // for "clicked" smart callback
         action: SIGNAL_EMIT "elm,action,click" "elm";
      }
      program { signal: "mouse,down,1,double"; source: "bar"; // for "clicked,double" smart callback
         action: SIGNAL_EMIT "elm,action,click,double" "elm";
      }
      program { // for elm_panes_fixed_set()
         signal: "elm,panes,fixed"; source: "elm";
         action: STATE_SET "disabled" 0.0;
         target: "bar";
      }
      program { // for elm_panes_fixed_set()
         signal: "elm,panes,unfixed"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "bar";
      }
   }
}

group { name: "elm/panes/horizontal/default";

   parts {
      part { name: "whole"; type: SPACER;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
         }
      }
      part { name: "right_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 0 0 0;
            y: 1 1 1;
         }
         description { offset_scale: 1; state: "default" 0.0;
            max: 0 0;
         }
      }
      part { name: "left_constraint"; type: SPACER;
         dragable { confine: "whole";
            x: 0 0 0;
            y: 1 1 1;
         }
         description { offset_scale: 1; state: "default" 0.0;
            max: 0 0;
         }
      }
      part { name: "sub_whole"; type: SPACER;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            rel1.relative: 0.0 1.0;
            rel1.to_y: "left_constraint";
            rel2.relative: 1.0 0.0;
            rel2.to_y: "right_constraint";
         }
      }
      part { name: "whole_left"; type: RECT;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            rel2.to_y: "elm.bar";
            rel2.relative: 1.0 0.0;
         }
      }
      part { name: "whole_right"; type: RECT;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            rel1.to_y: "elm.bar";
            rel1.relative: 0.0 1.0;
         }
      }
      part { name: "elm.swallow.left"; type: SWALLOW;
         clip_to: "whole_left";
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            rel2.to_y: "elm.bar";
            rel2.relative: 1.0 0.0;
         }
      }
      part { name: "elm.swallow.right"; type: SWALLOW;
         clip_to: "whole_right";
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            rel1.to_y: "elm.bar";
            rel1.relative: 0.0 1.0;
         }
      }
      part { name: "elm.bar"; type: SPACER;
         scale: 1;
         dragable { confine: "sub_whole";
            x: 0 0 0;
            y: 1 1 1;
         }
         description { offset_scale: 1; state: "default" 0.0;
            max: 99999 9;
            min: 24 9;
            fixed: 1 1;
            rel1.relative: 0.5 0.0;
            rel2.relative: 0.5 1.0;
         }
      }
      part { name: "dots"; mouse_events: 0;
         scale: 1;
         description { offset_scale: 1; state: "default" 0.0;
            min: 30 9; max: 30 9;
            image.normal: "handle-h.svg";
            fill.smooth: 0;
            rel.to: "elm.bar";
            color: 210 210 210 210;
         }
         description { offset_scale: 1; state: "over" 0.0; inherit: "default" 0.0; color: 255 255 255 255; }
         description { offset_scale: 1; state: "pressed" 0.0;
            inherit: "default" 0.0;
            color: 255 255 255 255;
         }
      }
      part { name: "elm.swallow.event"; type: SWALLOW;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            visible: 0;
            min: 24 9;
            fixed: 1 1;
            rel.to: "elm.bar";
         }
      }
      part { name: "bar"; type: RECT;
         scale: 1;
         dragable.events: "elm.bar";
         description { offset_scale: 1; state: "default" 0.0;
            min: 24 9;
            max: 99999 99999;
            fixed: 1 1;
            rel1.to_y: "elm.swallow.event";
            rel2.to_y: "elm.swallow.event";
            color: 0 0 0 0; // no cc
         }
         description { offset_scale: 1; state: "disabled" 0.0;
            inherit: "default" 0.0;
            visible: 0;
         }
      }
   }
   programs {
      program { signal: "mouse,in"; source: "bar"; action: STATE_SET "over" 0.0; target: "dots"; }
      program { signal: "mouse,out"; source: "bar"; action: STATE_SET "default" 0.0; target: "dots"; }
      program {signal: "mouse,down,1"; source: "bar"; // for "press" smart callback
         action: SIGNAL_EMIT "elm,action,press" "elm";
      }
      program { signal: "mouse,up,1"; source: "bar"; // for "unpress" smart callback
         action: SIGNAL_EMIT "elm,action,unpress" "elm";
      }
      program { name: "bar_down";
         signal: "mouse,down,1"; source: "bar";
         action: STATE_SET "pressed" 0.0;
         target: "dots";
      }
      program { name: "bar_up";
         signal: "mouse,up,1"; source: "bar";
         action: STATE_SET "default" 0.0;
         target: "dots";
      }
      program { signal: "mouse,clicked,1"; source: "bar"; // for "clicked" smart callback
         action: SIGNAL_EMIT "elm,action,click" "elm";
      }
      program { signal: "mouse,down,1,double"; source: "bar"; // for "clicked,double" smart callback
         action: SIGNAL_EMIT "elm,action,click,double" "elm";
      }
      program { // for elm_panes_fixed_set()
         signal: "elm,panes,fixed"; source: "elm";
         action: STATE_SET "disabled" 0.0;
         target: "bar";
      }
      program { // for elm_panes_fixed_set()
         signal: "elm,panes,unfixed"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "bar";
      }
   }
}

////////////////////////////////////////////////////////////////////////////


/* Shared popup title row, with the close control at the top right. */
group { name: "elm/popup/base/default";
   alias: "elm/popup/base/transparent";
   styles {
      style { name: "popup_title_style";
         base: "font=Sans:style=Bold font_size=11 text_class=label align=left color=cc:/fg/normal/popup/text/title wrap=mixed";
         tag: "br" "\n";
         tag: "hilight" "+ font_weight=Bold";
         tag: "b" "+ font_weight=Bold";
         tag: "whitecolor" "+ color=#fff"; // no cc
         tag: "tab" "\t";
      }
   }
   parts {
      part { name: "base"; type: RECT;
         scale: 1;
         description { offset_scale: 1; state: "default" 0.0;
            min: 180 0;
            color: 0 0 0 0; // no cc
         }
      }
      part { name: "elm.swallow.background"; type: SWALLOW;
         scale: 1;
         description { offset_scale: 1; state: "default" 0.0;
            fixed: 1 1;
            rel.to: "base";
         }
      }
      part { name: "elm.bg.title"; type: RECT;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            fixed: 1 1;
            rel.to: "elm.text.title";
            color: 0 0 0 0; // no cc
         }
      }
      part { name: "elm.text.title"; type: TEXTBLOCK;
         scale: 1;
         description { offset_scale: 1; state: "default" 0.0;
            fixed: 0 1;
            min: 0 27;
            text { style: "popup_title_style";
              min: 1 1;
              ellipsis: -1;
            }
            visible: 0;
            rel1.offset: 4 4;
            rel2.offset: -35 4;
            rel2.relative: 1.0 0.0;
            align: 0.5 0.0;
            
         }
         description { offset_scale: 1; state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "elm.swallow.title.icon"; type: SWALLOW;
         scale: 1;
         description { offset_scale: 1; state: "default" 0.0;
            fixed: 1 1;
            align: 1.0 0.5;
            min: 24 24; max: 24 24;
            rel1.to_y: "elm.text.title";
            rel2.to_y: "elm.text.title";
            rel1.relative: 1.0 0.0;
            rel1.offset: -29 0;
            rel2.relative: 1.0 1.0;
            rel2.offset: -4 -1;
            aspect: 1.0 1.0; aspect_preference: VERTICAL;
            visible: 0;
         }
         description { offset_scale: 1; state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }
      part { name: "elm.swallow.content"; type: SWALLOW;
         scale: 1;
         description { offset_scale: 1; state: "default" 0.0;
            rel1.offset: 4 4;
            rel2.offset: -5 -5;
            
         }
         description { offset_scale: 1; state: "show_title_area" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.0 1.0;
            rel1.to_y: "elm.bg.title";
         }
         description { offset_scale: 1; state: "show_action_area" 0.0;
            inherit: "default" 0.0;
            rel2.relative: 1.0 0.0;
            rel2.to_y: "elm.swallow.action_area";
         }
         description { offset_scale: 1; state: "show_action_title_area" 0.0;
            inherit: "default" 0.0;
            rel1.relative: 0.0 1.0;
            rel1.to_y: "elm.bg.title";
            rel2.relative: 1.0 0.0;
            rel2.to_y: "elm.swallow.action_area";
         }
      }
      part { name: "elm.swallow.action_area"; type: SWALLOW;
         scale: 1;
         description { offset_scale: 1; state: "default" 0.0;
            fixed: 0 1;
            align: 0.5 1.0;
            visible: 0;
            rel.to: "base";
            rel1.relative: 0.0 1.0;
            rel1.offset: 4 -5;
            rel2.offset: -5 -5;
            
         }
         description { offset_scale: 1; state: "visible" 0.0;
            inherit: "default" 0.0;
            visible: 1;
         }
      }

      part { name: "access.title"; type: RECT; repeat_events: 1;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            fixed: 1 1;
            rel.to: "elm.bg.title";
            color: 0 0 0 0; // no cc
         }
      }
      part { name: "access.body"; type: RECT; repeat_events: 1;
         scale: 1; description { offset_scale: 1; state: "default" 0.0;
            fixed: 1 1;
            rel.to: "elm.swallow.content";
            color: 0 0 0 0; // no cc
         }
      }
   }
   programs {
      program { signal: "elm,state,title,icon,visible"; source: "elm";
         action: STATE_SET "visible" 0.0;
         target: "elm.swallow.title.icon";
      }
      program { signal: "elm,state,title,icon,hidden"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "elm.swallow.title.icon";
      }
      program { signal: "elm,state,title,text,visible"; source: "elm";
         action: STATE_SET "visible" 0.0;
         target: "elm.text.title";
      }
      program { signal: "elm,state,title,text,hidden"; source: "elm";
         action: STATE_SET "default" 0.0;
         target: "elm.text.title";
      }
      program { signal: "elm,state,title_area,visible"; source: "elm";
         script {
            new st[31], Float:vl;
            get_state(PART:"elm.swallow.action_area", st, 30, vl);
            if (!strcmp(st, "visible"))
              set_state(PART:"elm.swallow.content", "show_action_title_area", 0.0);
            else
              set_state(PART:"elm.swallow.content", "show_title_area", 0.0);
            set_state(PART:"elm.text.title", "visible", 0.0);
         }
      }
      program { signal: "elm,state,title_area,hidden"; source: "elm";
         script {
            new st[31], Float:vl;
            get_state(PART:"elm.swallow.action_area", st, 30, vl);
            if (!strcmp(st, "visible"))
              set_state(PART:"elm.swallow.content", "show_action_area", 0.0);
            else
              set_state(PART:"elm.swallow.content", "default", 0.0);
            set_state(PART:"elm.text.title", "default", 0.0);
         }
      }
      program { signal: "elm,state,action_area,visible"; source: "elm";
         script {
            new st[31], Float:vl;
            get_state(PART:"elm.text.title", st, 30, vl);
            if (!strcmp(st, "visible"))
              set_state(PART:"elm.swallow.content", "show_action_title_area", 0.0);
            else
              set_state(PART:"elm.swallow.content", "show_action_area", 0.0);
            set_state(PART:"elm.swallow.action_area", "visible", 0.0);
         }
      }
      program { signal: "elm,state,action_area,hidden"; source: "elm";
         script {
            new st[31], Float:vl;
            get_state(PART:"elm.text.title", st, 30, vl);
            if (!strcmp(st, "visible"))
              set_state(PART:"elm.swallow.content", "show_title_area", 0.0);
            else
              set_state(PART:"elm.swallow.content", "default", 0.0);
            set_state(PART:"elm.swallow.action_area", "default", 0.0);
         }
      }
   }
}

