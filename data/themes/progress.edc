/* Elementary sends the fraction through elm.cur.progressbar and controls
 * indeterminate animation with pulse/start/stop signals. */
group { name: "elm/progressbar/horizontal/default";
 alias: "elm/progressbar/horizontal/bare";
 script {
  public progress_flags;
  public refresh(m) {
   if ((m & 1) || (m & 4) || ((m & 2) && !(m & 8)))
    set_state(PART:"heading", "visible", 0.0);
   else set_state(PART:"heading", "default", 0.0);
   if (m & 1) set_state(PART:"elm.text", "visible", 0.0);
   else set_state(PART:"elm.text", "default", 0.0);
   if ((m & 2) && !(m & 8)) set_state(PART:"elm.text.status", "visible", 0.0);
   else set_state(PART:"elm.text.status", "default", 0.0);
   if (m & 4) set_state(PART:"elm.swallow.content", "visible", 0.0);
   else set_state(PART:"elm.swallow.content", "default", 0.0);
  }
 }
 parts {
  part { name: "disabled-clip"; type: RECT; mouse_events: 0;
   description { state: "default" 0.0; color: 255 255 255 255; }
   description { state: "disabled" 0.0; inherit: "default" 0.0; color: 255 255 255 96; }
  }
  part { name: "heading"; type: SPACER; scale: 1;
   description { state: "default" 0.0; fixed: 0 1; align: 0.5 0; rel2.relative: 1 0; }
   description { state: "visible" 0.0; inherit: "default" 0.0; min: 0 24; }
  }
  part { name: "elm.swallow.content"; type: SWALLOW; scale: 1; clip_to: "disabled-clip";
   description { state: "default" 0.0; rel.to: "heading"; rel2.relative: 0 1; fixed: 1 1; align: 0 0.5; visible: 0; }
   description { state: "visible" 0.0; inherit: "default" 0.0; min: 20 20; visible: 1; }
  }
  part { name: "elm.text.status"; type: TEXT; scale: 1; mouse_events: 0; clip_to: "disabled-clip";
   description { state: "default" 0.0; rel.to: "heading"; rel1.relative: 1 0; fixed: 1 1; align: 1 0.5; visible: 0;
    color: INK; text { text_class: "label"; font: "Sans"; size: 10; align: 1 0.5; }
   }
   description { state: "visible" 0.0; inherit: "default" 0.0; visible: 1; text { min: 1 1; ellipsis: -1; } }
  }
  part { name: "elm.text"; type: TEXT; scale: 1; mouse_events: 0; clip_to: "disabled-clip";
   description { state: "default" 0.0; offset_scale: 1; rel.to_y: "heading";
    rel1 { to_x: "elm.swallow.content"; relative: 1 0; offset: 4 0; }
    rel2 { to_x: "elm.text.status"; relative: 0 1; offset: -9 -1; }
    color: INK; visible: 0; text { text_class: "label"; font: "Sans"; size: 11; align: 0 0.5; }
   }
   description { state: "visible" 0.0; inherit: "default" 0.0; visible: 1; text.min: 0 1; }
  }
  part { name: "track"; type: RECT; scale: 1; mouse_events: 0; clip_to: "disabled-clip";
   description { state: "default" 0.0; offset_scale: 1; min: 24 8; max: 99999 8;
    rel1 { to_y: "heading"; relative: 0 1; offset: 0 4; } color: EDGE;
   }
  }
  part { name: "elm.swallow.bar"; type: SWALLOW; mouse_events: 0;
   description { state: "default" 0.0; rel.to: "track"; }
  }
  part { name: "elm.cur.progressbar"; type: SPACER;
   dragable { confine: "track"; x: 1 1 1; y: 0 0 0; }
   description { state: "default" 0.0; rel.to: "track"; fixed: 1 1; min: 1 1; max: 1 99999; }
  }
  part { name: "fraction-clip"; type: RECT; mouse_events: 0; clip_to: "disabled-clip";
   description { state: "default" 0.0; rel.to: "track"; }
   description { state: "pulse" 0.0; inherit: "default" 0.0; visible: 0; }
  }
  part { name: "bar"; type: RECT; mouse_events: 0; clip_to: "fraction-clip";
   description { state: "default" 0.0; rel1.to: "track";
    rel2 { to_x: "elm.cur.progressbar"; to_y: "track"; relative: 0 1; } color: ACCENT;
   }
   description { state: "inverted" 0.0; inherit: "default" 0.0;
    rel1 { to_x: "elm.cur.progressbar"; to_y: "track"; relative: 1 0; }
    rel2 { to: "track"; relative: 1 1; }
   }
  }
  part { name: "pulse-clip"; type: RECT; mouse_events: 0; clip_to: "disabled-clip";
   description { state: "default" 0.0; rel.to: "track"; visible: 0; }
   description { state: "active" 0.0; inherit: "default" 0.0; visible: 1; }
  }
  part { name: "pulse"; type: RECT; mouse_events: 0; clip_to: "pulse-clip";
   description { state: "default" 0.0; rel.to: "track"; rel2.relative: 0.25 1; color: ACCENT; }
   description { state: "end" 0.0; inherit: "default" 0.0; rel1.relative: 0.75 0; rel2.relative: 1 1; }
  }
 }
 programs {
  program { signal: "elm,state,text,visible"; source: "elm"; script { new m = get_int(progress_flags) | 1; set_int(progress_flags, m); refresh(m); } }
  program { signal: "elm,state,text,hidden"; source: "elm"; script { new m = get_int(progress_flags) & ~1; set_int(progress_flags, m); refresh(m); } }
  program { signal: "elm,state,units,visible"; source: "elm"; script { new m = get_int(progress_flags) | 2; set_int(progress_flags, m); refresh(m); } }
  program { signal: "elm,state,units,hidden"; source: "elm"; script { new m = get_int(progress_flags) & ~2; set_int(progress_flags, m); refresh(m); } }
  program { signal: "elm,state,icon,visible"; source: "elm"; script { new m = get_int(progress_flags) | 4; set_int(progress_flags, m); refresh(m); } }
  program { signal: "elm,state,icon,hidden"; source: "elm"; script { new m = get_int(progress_flags) & ~4; set_int(progress_flags, m); refresh(m); } }
  program { signal: "elm,state,pulse"; source: "elm";
   script { new m = get_int(progress_flags) | 8; set_int(progress_flags, m); refresh(m); }
   after: "fraction-hide";
  }
  program { name: "fraction-hide"; action: STATE_SET "pulse" 0.0; target: "fraction-clip"; }
  program { signal: "elm,state,pulse,start"; source: "elm";
   action: STATE_SET "active" 0.0; target: "pulse-clip"; after: "pulse-forward";
  }
  program { name: "pulse-forward"; action: STATE_SET "end" 0.0; target: "pulse"; transition: SINUSOIDAL 0.8; after: "pulse-back"; }
  program { name: "pulse-back"; action: STATE_SET "default" 0.0; target: "pulse"; transition: SINUSOIDAL 0.8; after: "pulse-forward"; }
  program { name: "pulse-stop"; signal: "elm,state,pulse,stop"; source: "elm";
   action: ACTION_STOP; target: "pulse-forward"; target: "pulse-back"; after: "pulse-hide";
  }
  program { name: "pulse-hide"; action: STATE_SET "default" 0.0; target: "pulse-clip"; target: "pulse"; }
  program { signal: "elm,state,fraction"; source: "elm";
   script { new m = get_int(progress_flags) & ~8; set_int(progress_flags, m); refresh(m); }
   after: "fraction-show";
  }
  program { name: "fraction-show"; action: STATE_SET "default" 0.0; target: "fraction-clip"; after: "pulse-stop"; }
  program { signal: "elm,state,inverted,on"; source: "elm"; action: STATE_SET "inverted" 0.0; target: "bar"; }
  program { signal: "elm,state,inverted,off"; source: "elm"; action: STATE_SET "default" 0.0; target: "bar"; }
  program { signal: "elm,state,disabled"; source: "elm"; action: STATE_SET "disabled" 0.0; target: "disabled-clip"; }
  program { signal: "elm,state,enabled"; source: "elm"; action: STATE_SET "default" 0.0; target: "disabled-clip"; }
 }
}

group { name: "elm/progressbar/vertical/default";
 alias: "elm/progressbar/vertical/bare";
 inherit: "elm/progressbar/horizontal/default";
 parts {
  part { name: "track"; description { state: "default" 0.0; min: 8 24; max: 8 99999; } }
  part { name: "elm.cur.progressbar";
   dragable { x: 0 0 0; y: 1 1 1; }
   description { state: "default" 0.0; max: 99999 1; }
  }
  part { name: "bar";
   description { state: "default" 0.0; rel2 { to_x: "track"; to_y: "elm.cur.progressbar"; relative: 1 0; } }
   description { state: "inverted" 0.0; rel1 { to_x: "track"; to_y: "elm.cur.progressbar"; relative: 0 1; } }
  }
  part { name: "pulse";
   description { state: "default" 0.0; rel2.relative: 1 0.25; }
   description { state: "end" 0.0; rel1.relative: 0 0.75; rel2.relative: 1 1; }
  }
 }
}
